[
  {
    "id": 1,
    "start": 0,
    "end": 3.3,
    "who": "sajid",
    "text": "চাচা, আগে টাকা নেন। এই লোক কিন্তু বিল দেবে না!"
  },
  {
    "id": 2,
    "start": 3.85,
    "end": 6.43,
    "who": "narrator",
    "text": "ছেঁড়া জামার মানুষটার সামনেই কথাটা বলল সাজিদ।"
  },
  {
    "id": 3,
    "start": 6.65,
    "end": 8.6,
    "who": "narrator",
    "text": "লোকটা চায়ের কাপ নামিয়ে রাখলেন।"
  },
  {
    "id": 4,
    "start": 9.1,
    "end": 11.0,
    "who": "teacher",
    "text": "এক কাপ চায়ের টাকা আছে, বাবা।"
  },
  {
    "id": 5,
    "start": 11.6,
    "end": 13.9,
    "who": "narrator",
    "text": "করিম চাচার দোকানের কোণে বসেছিলেন তিনি।"
  },
  {
    "id": 6,
    "start": 14.16,
    "end": 16.1,
    "who": "narrator",
    "text": "পাশে পুরোনো একটা কাপড়ের ব্যাগ।"
  },
  {
    "id": 7,
    "start": 16.4,
    "end": 18.8,
    "who": "narrator",
    "text": "সাজিদ রাফির দিকে তাকিয়ে মুচকি হাসল।"
  },
  {
    "id": 8,
    "start": 19.02,
    "end": 21.88,
    "who": "narrator",
    "text": "ঠিক তখনই ব্যাগ থেকে কয়েকটা খাতা মাটিতে পড়ে গেল।"
  },
  {
    "id": 9,
    "start": 22.0,
    "end": 23.72,
    "who": "narrator",
    "text": "রাফি তুলে দিতে গিয়ে দেখল—"
  },
  {
    "id": 10,
    "start": 23.78,
    "end": 25.74,
    "who": "narrator",
    "text": "লাল কালিতে অঙ্ক ঠিক করা।"
  },
  {
    "id": 11,
    "start": 25.83,
    "end": 27.12,
    "who": "narrator",
    "text": "এক পাতায় লেখা,"
  },
  {
    "id": 12,
    "start": 27.22,
    "end": 29.0,
    "who": "narrator",
    "text": "আবার চেষ্টা করো। পারবে।"
  },
  {
    "id": 13,
    "start": 29.25,
    "end": 30.48,
    "who": "narrator",
    "text": "রাফি জিজ্ঞেস করল,"
  },
  {
    "id": 14,
    "start": 30.48,
    "end": 31.27,
    "who": "rafi",
    "text": "আপনি পড়ান?"
  },
  {
    "id": 15,
    "start": 31.62,
    "end": 34.24,
    "who": "narrator",
    "text": "লোকটা উত্তর দেওয়ার আগেই করিম চাচা এগিয়ে এলেন।"
  },
  {
    "id": 16,
    "start": 34.25,
    "end": 35.65,
    "who": "karim",
    "text": "স্যার! আপনি?"
  },
  {
    "id": 17,
    "start": 36.06,
    "end": 38.36,
    "who": "narrator",
    "text": "চাচা তাড়াতাড়ি পাশের চেয়ারটা টেনে দিলেন।"
  },
  {
    "id": 18,
    "start": 38.81,
    "end": 42.97,
    "who": "karim",
    "text": "আমার মেয়েটা যখন পড়া ছেড়ে দিচ্ছিল, এই মানুষটাই বিনা টাকায় পড়িয়েছেন।"
  },
  {
    "id": 19,
    "start": 43.3,
    "end": 44.9,
    "who": "narrator",
    "text": "সাজিদের হাসি মিলিয়ে গেল।"
  },
  {
    "id": 20,
    "start": 45.03,
    "end": 46.0,
    "who": "narrator",
    "text": "লোকটা বললেন,"
  },
  {
    "id": 21,
    "start": 46.0,
    "end": 48.53,
    "who": "teacher",
    "text": "এখন রেললাইনের পাশের কয়েকটা বাচ্চাকে পড়াই।"
  },
  {
    "id": 22,
    "start": 48.57,
    "end": 50.3,
    "who": "teacher",
    "text": "ওদের খাতাগুলো দেখে ফিরছিলাম।"
  },
  {
    "id": 23,
    "start": 50.81,
    "end": 52.37,
    "who": "narrator",
    "text": "সাজিদ নিচু স্বরে বলল,"
  },
  {
    "id": 24,
    "start": 52.74,
    "end": 54.44,
    "who": "sajid",
    "text": "স্যার, বুঝতে পারিনি।"
  },
  {
    "id": 25,
    "start": 54.48,
    "end": 55.75,
    "who": "sajid",
    "text": "চায়ের বিলটা আমি দিই?"
  },
  {
    "id": 26,
    "start": 56.09,
    "end": 57.9,
    "who": "narrator",
    "text": "লোকটা পকেট থেকে টাকা বের করলেন।"
  },
  {
    "id": 27,
    "start": 58.23,
    "end": 59.48,
    "who": "teacher",
    "text": "বিল আমি দেব, বাবা।"
  },
  {
    "id": 28,
    "start": 59.77,
    "end": 61.27,
    "who": "narrator",
    "text": "তারপর একটু হেসে বললেন,"
  },
  {
    "id": 29,
    "start": 61.58,
    "end": 63.2,
    "who": "teacher",
    "text": "তবে চেয়ারটা এগিয়ে দিতে পারো।"
  },
  {
    "id": 30,
    "start": 63.6,
    "end": 65.15,
    "who": "narrator",
    "text": "সাজিদ চেয়ারটা এগিয়ে দিল।"
  },
  {
    "id": 31,
    "start": 65.25,
    "end": 68.99,
    "who": "narrator",
    "text": "এবার মানুষটার পরিচয় জানার জন্য নয়—তাঁকে বসতে দেওয়ার জন্য।"
  }
]