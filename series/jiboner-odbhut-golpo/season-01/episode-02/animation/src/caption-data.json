    "endMs": 25980,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "দে, করে দিচ্ছি।",
    "startMs": 26300,
    "endMs": 27300,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "কিছুক্ষণ পর আরেক সহকর্মীর কম্পিউটারে সমস্যা।",
    "startMs": 27700,
    "endMs": 30880,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "তারপর একটা রিপোর্টের হিসাব মেলানোর অনুরোধ।",
    "startMs": 30880,
