    "endMs": 22680,
    "timestampMs": null,
    "confidence": null
  },
  {
    "text": "তোর তো এসব করতে বেশি সময় লাগে না।",
    "startMs": 22820,
    "endMs": 25020,
    "timestampMs": null,
    "confidence": null
  },
