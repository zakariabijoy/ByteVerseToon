[
  {
    "who": "sajid",
    "start": 2.08,
    "end": 4.02,
    "text": "বন্ধুর কাছেও এত হিসাব রাখিস?"
  },
  {
    "who": "sajid",
    "start": 13.5,
    "end": 15.52,
    "text": "দোস্ত, একশটা টাকা দে তো।"
  },
  {
    "who": "sajid",
    "start": 15.52,
    "end": 16.4,
    "text": "কালই ফেরত দেব।"
  },
  {
    "who": "sajid",
    "start": 22.5,
    "end": 24.08,
    "text": "আচ্ছা, দিচ্ছি।"
  },
  {
    "who": "sajid",
    "start": 28.85,
    "end": 31.09,
    "text": "চাচা, আজ সবার চা আমার!"
  },
  {
    "who": "rafi",
    "start": 32.6,
    "end": 35.04,
    "text": "দোস্ত, আমার একশ টাকাটাও দিয়ে দিস।"
  },
  {
    "who": "sajid",
    "start": 36.95,
    "end": 38.79,
    "text": "আরে, একশ টাকাই তো!"
  },
  {
    "who": "sajid",
    "start": 38.93,
    "end": 40.81,
    "text": "বন্ধুর কাছেও এত হিসাব রাখিস?"
  },
  {
    "who": "rafi",
    "start": 41.99,
    "end": 44.39,
    "text": "তুই তো পরদিনই দেওয়ার কথা বলেছিলি।"
  },
  {
    "who": "karim",
    "start": 47.35,
    "end": 50.71,
    "text": "যেদিন দরকার ছিল, সেদিনও কি বলেছিলি—একশ টাকাই তো?"
  },
  {
    "who": "sajid",
    "start": 53.76,
    "end": 56.6,
    "text": "আমি ভেবেছিলাম, তোর এখন দরকার নেই।"
  },
  {
    "who": "rafi",
    "start": 57.72,
    "end": 60.06,
    "text": "দরকার আছে কি না, জিজ্ঞেস করেছিস?"
  },
  {
    "who": "sajid",
    "start": 62.44,
    "end": 64.02,
    "text": "ঠিক বলেছিস।"
  },
  {
    "who": "sajid",
    "start": 64.02,
    "end": 65.42,
    "text": "ভুলে গেছি বলে দুঃখিত।"
  },
  {
    "who": "sajid",
    "start": 65.42,
    "end": 66.96,
    "text": "উল্টো তোকে কথাও শোনালাম।"
  },
  {
    "who": "karim",
    "start": 68.31,
    "end": 70.47,
    "text": "যাক, এবার চায়ের বিলটা দে।"
  },
  {
    "who": "karim",
    "start": 70.47,
    "end": 71.67,
    "text": "ওটা কিন্তু ধার নয়!"
  }
]